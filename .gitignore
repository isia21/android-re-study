# ==============================================================================
# 1. ТАРГЕТЫ И БИНАРНИКИ (Тяжелые APK, OBB, кэши)
# ==============================================================================
*.apk
*.xapk
*.apks
*.aab
*.obb
*.zip
*.tar.gz
*.7z

# !app/*.apk

# ==============================================================================
# 2. ИССЛЕДОВАТЕЛЬСКИЙ ТУЛИНГ: IDA PRO / GHIDRA
# ==============================================================================
*.idb
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.til.bak
*.asm
*.idatmp*

# Экспорт / дампы Ghidra
*.rep/
*.gpr

# ==============================================================================
# 3. ДЕКОМПИЛЯЦИЯ: JADX, APKTOOL, SMALI
# ==============================================================================
# Кэш проектов JADX-GUI
.jadx/
*.jadx
*.jadx.bk

# Рабочие папки APKTool (разобранные ресурсы и байт-код)
# Хранить тысячи мелких .smali файлов в гите — верная смерть для производительности
**/smali/
**/smali_classes*/
**/dist/
**/build/
apktool.yml

# Байт-код и промежуточные дампы Android
*.dex
*.odex
*.vdex
*.art

# ==============================================================================
# 4. ДВИЖКИ И ДАМПЕРЫ: UNITY / IL2CPP
# ==============================================================================
# Дампы Il2CppDumper (оставляем только dump.cs и script.json, если они нужны)
DummyDll/
il2cpp.h
*.dat

# ==============================================================================
# 5. СЕТЬ И ТРАФИК: BURP, WIRESHARK, LOGCAT
# ==============================================================================
*.pcap
*.pcapng
*.cap
*.burp
*.log
*.dmp
logcat.txt

# Сертификаты безопасности
*.pem
*.key
*.p12
*.jks
*.keystore

# ==============================================================================
# 6. СКРИПТЫ, ДИНАМИКА: PYTHON, FRIDA, NODE.JS
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# На случай если будут сборки Frida-агентов на TypeScript/Node
node_modules/
package-lock.json

# ==============================================================================
# 7. СИСТЕМНЫЙ МУСОР И IDE
# ==============================================================================
.vscode/
.idea/
*.suo
*.user
*.vs/
Thumbs.db
Desktop.ini
$RECYCLE.BIN/